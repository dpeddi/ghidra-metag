<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <global><range space="ram"/></global>
  <stackpointer register="A0StP" space="ram" growth="positive"/>
  <default_proto>
    <prototype name="__metacall" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4"><register name="D1Ar1"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="D0Ar2"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="D1Ar3"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="D0Ar4"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="D1Ar5"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="D0Ar6"/></pentry>
        <pentry minsize="1" maxsize="500" align="4"><addr offset="0" space="stack"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4"><register name="D0Re0"/></pentry>
      </output>
      <unaffected>
        <register name="A0StP"/><register name="A0FrP"/><register name="A1GbP"/><register name="D1RtP"/>
      </unaffected>
      <returnaddress><register name="D1RtP"/></returnaddress>
    </prototype>
  </default_proto>
</compiler_spec>
