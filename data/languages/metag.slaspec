Roff: gor_d0 is bu=1 & gor_d0 { export gor_d0; }
Roff: gor_d1 is bu=2 & gor_d1 { export gor_d1; }
Roff: gor_a0 is bu=3 & gor_a0 { export gor_a0; }
Udst: mdn_d0 is mdu=1 & mdn_d0 { export mdn_d0; }
Udst: mdn_d1 is mdu=2 & mdn_d1 { export mdn_d1; }
Udst: mdn_a0 is mdu=3 & mdn_a0 { export mdn_a0; }
