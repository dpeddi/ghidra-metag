Ddst: dno is u24=0 & dno { export dno; }
Ddst: dno_d1 is u24=1 & dno_d1 { export dno_d1; }
Ds1: s1no is u24=0 & s1no { export s1no; }
Ds1: s1no_d1 is u24=1 & s1no_d1 { export s1no_d1; }
Ds2: s2no is u24=0 & s2no { export s2no; }
Ds2: s2no_d1 is u24=1 & s2no_d1 { export s2no_d1; }
Adst: dno_a0 is u24=0 & dno_a0 { export dno_a0; }
Adst: dno_a1 is u24=1 & dno_a1 { export dno_a1; }
As1: s1no_a0 is u24=0 & s1no_a0 { export s1no_a0; }
As1: s1no_a1 is u24=1 & s1no_a1 { export s1no_a1; }
As2: s2no_a0 is u24=0 & s2no_a0 { export s2no_a0; }
As2: s2no_a1 is u24=1 & s2no_a1 { export s2no_a1; }
Rdata: gdno is gu=1 & gdno { export gdno; }
Rdata: gdno_d1 is gu=2 & gdno_d1 { export gdno_d1; }
Rdata: gdno_a0 is gu=3 & gdno_a0 { export gdno_a0; }
Rdata: gdno_a1 is gu=4 & gdno_a1 { export gdno_a1; }
