Usrc: msn_a1 is msu=4 & msn_a1 { export msn_a1; }
btarg: reloc is boff [ reloc = inst_start + (boff << 2); ] { export *:4 reloc; }
# ---- control flow ----
:B btarg is op=0xa & minor=0 & bcc=0 & b0=0 & btarg { goto btarg; }
:BEQ btarg is op=0xa & minor=0 & bcc=1 & btarg { if (ZF) goto btarg; }
:BNE btarg is op=0xa & minor=0 & bcc=2 & btarg { if (ZF==0) goto btarg; }
:BCS btarg is op=0xa & minor=0 & bcc=3 & btarg { if (CF) goto btarg; }
:BCC btarg is op=0xa & minor=0 & bcc=4 & btarg { if (CF==0) goto btarg; }
:BMI btarg is op=0xa & minor=0 & bcc=5 & btarg { if (NF) goto btarg; }
:BPL btarg is op=0xa & minor=0 & bcc=6 & btarg { if (NF==0) goto btarg; }
:BVS btarg is op=0xa & minor=0 & bcc=7 & btarg { if (VF) goto btarg; }
:BVC btarg is op=0xa & minor=0 & bcc=8 & btarg { if (VF==0) goto btarg; }
:BHI btarg is op=0xa & minor=0 & bcc=9 & btarg { if (CF&&ZF==0) goto btarg; }
:BLS btarg is op=0xa & minor=0 & bcc=10 & btarg { if (CF==0||ZF) goto btarg; }
:BGE btarg is op=0xa & minor=0 & bcc=11 & btarg { if (NF==VF) goto btarg; }
:BLT btarg is op=0xa & minor=0 & bcc=12 & btarg { if (NF!=VF) goto btarg; }
:BGT btarg is op=0xa & minor=0 & bcc=13 & btarg { if (ZF==0&&NF==VF) goto btarg; }
:BLE btarg is op=0xa & minor=0 & bcc=14 & btarg { if (ZF||NF!=VF) goto btarg; }
:BR btarg is op=0xa & minor=0 & bcc=0 & b0=1 & btarg { TXRPT=TXRPT-1; if (TXRPT!=0) goto btarg; }
:CALLR btarg is op=0xa & minor=0xb & btarg { D1RtP = inst_next; call btarg; }
:RET is op=0xa & minor=3 & misc24=0x2008a0 { return [D1RtP]; }
:CALLRtp is op=0xa & minor=3 & misc24=0x200aa0 { local t=D1RtP; D1RtP=inst_next; call [t]; }
# ---- MOV cross-unit (op=0xa minor=3) ----
:MOV Usrc is op=0xa & minor=3 & b9=0 & mdu=0 & mdn=3 & Usrc { TXRPT = Usrc; }
:MOV Udst,Usrc is op=0xa & minor=3 & b9=0 & Udst & Usrc { Udst = Usrc; }
# ---- GP ALU reg-reg ----
:ADD Ddst,Ds1,Ds2 is op=0x0 & i25=0 & c26=0 & m27=0 & Ddst & Ds1 & Ds2 { Ddst = Ds1 + Ds2; }
:SUB Ddst,Ds1,Ds2 is op=0x1 & i25=0 & c26=0 & m27=0 & Ddst & Ds1 & Ds2 { Ddst = Ds1 - Ds2; }
:AND Ddst,Ds1,Ds2 is op=0x2 & i25=0 & c26=0 & m27=0 & Ddst & Ds1 & Ds2 { Ddst = Ds1 & Ds2; }
:OR Ddst,Ds1,Ds2 is op=0x3 & i25=0 & c26=0 & m27=0 & Ddst & Ds1 & Ds2 { Ddst = Ds1 | Ds2; }
:XOR Ddst,Ds1,Ds2 is op=0x4 & i25=0 & c26=0 & m27=0 & Ddst & Ds1 & Ds2 { Ddst = Ds1 ^ Ds2; }
:MUL Ddst,Ds1,Ds2 is op=0x6 & i25=0 & c26=0 & Ddst & Ds1 & Ds2 { Ddst = Ds1 * Ds2; }
:CMP Ds1,Ds2 is op=0x7 & i25=0 & c26=0 & Ds1 & Ds2 { local d=Ds1-Ds2; ZF=(d==0); NF=(d s< 0); CF=(Ds1 < Ds2); }
:TST Ds1,Ds2 is op=0x2 & i25=0 & c26=1 & Ds1 & Ds2 { local d=Ds1&Ds2; ZF=(d==0); NF=(d s< 0); }
# ---- GP ALU immediate ----
:MOV Ddst,imm16 is op=0x0 & i25=1 & c26=0 & b0=0 & o1zb=1 & Ddst & imm16 { Ddst = imm16; }
:ADD Ddst,imm16 is op=0x0 & i25=1 & c26=0 & b0=0 & o1zb=0 & Ddst & imm16 { Ddst = Ddst + imm16; }
:SUB Ddst,imm16 is op=0x1 & i25=1 & c26=0 & b0=0 & o1zb=0 & Ddst & imm16 { Ddst = Ddst - imm16; }
:CMP Ddst,imm16 is op=0x7 & i25=1 & c26=0 & Ddst & imm16 { local d=Ddst-imm16; ZF=(d==0); NF=(d s< 0); CF=(Ddst < imm16); }
# ---- ADDR-unit ALU (A0/A1) ----
:ADD Adst,As1,As2 is op=0x8 & m27=0 & i25=0 & c26=0 & Adst & As1 & As2 { Adst = As1 + As2; }
:ADD Adst,imm16 is op=0x8 & m27=0 & i25=1 & c26=0 & b0=0 & o1zb=0 & Adst & imm16 { Adst = Adst + imm16; }
:SUB Adst,As1,As2 is op=0x8 & m27=1 & i25=0 & c26=0 & Adst & As1 & As2 { Adst = As1 - As2; }
:SUB Adst,imm16 is op=0x8 & m27=1 & i25=1 & c26=0 & o1zb=0 & Adst & imm16 { Adst = Adst - imm16; }
:MOV Adst,imm16 is op=0x8 & m27=0 & i25=1 & c26=0 & b0=0 & o1zb=1 & Adst & imm16 { Adst = imm16; }
# ---- GET/SET (base+imm / base+reg / base++) ----
:GETB Rdata,[Base+goff] is op=0xc & m27=0 & m24=0 & m26=0 & gimm=1 & ua7=0 & Rdata & Base & goff { local ea=Base+goff*1; Rdata=zext(*[ram]:1 ea); }
:SETB [Base+goff],Rdata is op=0xb & m27=0 & m24=0 & m26=0 & gimm=1 & ua7=0 & Rdata & Base & goff { local ea=Base+goff*1; *[ram]:1 ea = Rdata:1; }
:GETB Rdata,[Base+Roff] is op=0xc & m27=0 & m24=0 & m26=0 & gimm=0 & ua7=0 & Rdata & Base & Roff { local ea=Base+Roff; Rdata=zext(*[ram]:1 ea); }
:SETB [Base+Roff],Rdata is op=0xb & m27=0 & m24=0 & m26=0 & gimm=0 & ua7=0 & Rdata & Base & Roff { local ea=Base+Roff; *[ram]:1 ea = Rdata:1; }
:GETB Rdata,[Base++] is op=0xc & m27=0 & m24=0 & m26=0 & gimm=1 & ua7=1 & Rdata & Base & goff { local ea=Base; Rdata=zext(*[ram]:1 ea); Base=Base+goff*1; }
:SETB [Base++],Rdata is op=0xb & m27=0 & m24=0 & m26=0 & gimm=1 & ua7=1 & Rdata & Base & goff { local ea=Base; *[ram]:1 ea = Rdata:1; Base=Base+goff*1; }
:GETW Rdata,[Base+goff] is op=0xc & m27=0 & m24=1 & m26=0 & gimm=1 & ua7=0 & Rdata & Base & goff { local ea=Base+goff*2; Rdata=zext(*[ram]:2 ea); }
:SETW [Base+goff],Rdata is op=0xb & m27=0 & m24=1 & m26=0 & gimm=1 & ua7=0 & Rdata & Base & goff { local ea=Base+goff*2; *[ram]:2 ea = Rdata:2; }
:GETW Rdata,[Base+Roff] is op=0xc & m27=0 & m24=1 & m26=0 & gimm=0 & ua7=0 & Rdata & Base & Roff { local ea=Base+Roff; Rdata=zext(*[ram]:2 ea); }
:SETW [Base+Roff],Rdata is op=0xb & m27=0 & m24=1 & m26=0 & gimm=0 & ua7=0 & Rdata & Base & Roff { local ea=Base+Roff; *[ram]:2 ea = Rdata:2; }
:GETW Rdata,[Base++] is op=0xc & m27=0 & m24=1 & m26=0 & gimm=1 & ua7=1 & Rdata & Base & goff { local ea=Base; Rdata=zext(*[ram]:2 ea); Base=Base+goff*2; }
:SETW [Base++],Rdata is op=0xb & m27=0 & m24=1 & m26=0 & gimm=1 & ua7=1 & Rdata & Base & goff { local ea=Base; *[ram]:2 ea = Rdata:2; Base=Base+goff*2; }
:GETD Rdata,[Base+goff] is op=0xc & m27=0 & m24=0 & m26=1 & gimm=1 & ua7=0 & Rdata & Base & goff { local ea=Base+goff*4; Rdata=*[ram]:4 ea; }
:SETD [Base+goff],Rdata is op=0xb & m27=0 & m24=0 & m26=1 & gimm=1 & ua7=0 & Rdata & Base & goff { local ea=Base+goff*4; *[ram]:4 ea = Rdata; }
:GETD Rdata,[Base+Roff] is op=0xc & m27=0 & m24=0 & m26=1 & gimm=0 & ua7=0 & Rdata & Base & Roff { local ea=Base+Roff; Rdata=*[ram]:4 ea; }
:SETD [Base+Roff],Rdata is op=0xb & m27=0 & m24=0 & m26=1 & gimm=0 & ua7=0 & Rdata & Base & Roff { local ea=Base+Roff; *[ram]:4 ea = Rdata; }
:GETD Rdata,[Base++] is op=0xc & m27=0 & m24=0 & m26=1 & gimm=1 & ua7=1 & Rdata & Base & goff { local ea=Base; Rdata=*[ram]:4 ea; Base=Base+goff*4; }
:SETD [Base++],Rdata is op=0xb & m27=0 & m24=0 & m26=1 & gimm=1 & ua7=1 & Rdata & Base & goff { local ea=Base; *[ram]:4 ea = Rdata; Base=Base+goff*4; }
# ---- GETL/SETL (64-bit pair, approx as 4-byte) ----
:GETL gdno,gdno_d1,[Base+goff] is op=0xc & m27=0 & m24=1 & m26=1 & gimm=1 & ua7=0 & gu=1 & gdno & gdno_d1 & Base & goff { local ea=Base+goff*8; gdno=*[ram]:4 ea; gdno_d1=*[ram]:4 (ea+4); }
:GETL Rdata,[Base+goff] is op=0xc & m27=0 & m24=1 & m26=1 & gimm=1 & ua7=0 & Rdata & Base & goff { local ea=Base+goff*8; Rdata=*[ram]:4 ea; }
:SETL [Base+goff],gdno,gdno_d1 is op=0xb & m27=0 & m24=1 & m26=1 & gimm=1 & ua7=0 & gu=1 & gdno & gdno_d1 & Base & goff { local ea=Base+goff*8; *[ram]:4 ea = gdno; *[ram]:4 (ea+4) = gdno_d1; }
:SETL [Base+goff],Rdata is op=0xb & m27=0 & m24=1 & m26=1 & gimm=1 & ua7=0 & Rdata & Base & goff { local ea=Base+goff*8; *[ram]:4 ea = Rdata; }
# ---- MGET/MSET push/pop ----
:MSETL [Base++] is op=0xb & minor=9 & Base & rmask { local n:4=(popcount(rmask:4)+1)*8; Base=Base+n; }
:MSETD [Base++] is op=0xb & minor=8 & Base & rmask { local n:4=(popcount(rmask:4)+1)*4; Base=Base+n; }
:MGETL [Base++] is op=0xc & minor=9 & Base & rmask { local n:4=(popcount(rmask:4)+1)*8; Base=Base+n; }
:MGETD [Base++] is op=0xc & minor=8 & Base & rmask { local n:4=(popcount(rmask:4)+1)*4; Base=Base+n; }
# ---- extended GET/SET (op=0xa, minor 7=GET 5=SET) ----
RdataExt: erno_d0 is eru=1 & erno_d0 { export erno_d0; }
RdataExt: erno_d1 is eru=2 & erno_d1 { export erno_d1; }
RdataExt: erno_a0 is eru=3 & erno_a0 { export erno_a0; }
RdataExt: erno_a1 is eru=0 & erno_a1 { export erno_a1; }
BaseExt: ebno_a0 is ebu=3 & ebno_a0 { export ebno_a0; }
BaseExt: ebno_d0 is ebu=1 & ebno_d0 { export ebno_d0; }
BaseExt: ebno_d1 is ebu=2 & ebno_d1 { export ebno_d1; }
BaseExt: ebno_a1 is ebu=0 & ebno_a1 { export ebno_a1; }
:GETB RdataExt,[BaseExt+eoff] is op=0xa & minor=7 & es=0 & RdataExt & BaseExt & eoff { local ea=BaseExt+eoff*1; RdataExt=zext(*[ram]:1 ea); }
:SETB [BaseExt+eoff],RdataExt is op=0xa & minor=5 & es=0 & RdataExt & BaseExt & eoff { local ea=BaseExt+eoff*1; *[ram]:1 ea = RdataExt:1; }
:GETW RdataExt,[BaseExt+eoff] is op=0xa & minor=7 & es=1 & RdataExt & BaseExt & eoff { local ea=BaseExt+eoff*2; RdataExt=zext(*[ram]:2 ea); }
:SETW [BaseExt+eoff],RdataExt is op=0xa & minor=5 & es=1 & RdataExt & BaseExt & eoff { local ea=BaseExt+eoff*2; *[ram]:2 ea = RdataExt:2; }
:GETD RdataExt,[BaseExt+eoff] is op=0xa & minor=7 & es=2 & RdataExt & BaseExt & eoff { local ea=BaseExt+eoff*4; RdataExt=*[ram]:4 ea; }
:SETD [BaseExt+eoff],RdataExt is op=0xa & minor=5 & es=2 & RdataExt & BaseExt & eoff { local ea=BaseExt+eoff*4; *[ram]:4 ea = RdataExt; }
:GETL RdataExt,[BaseExt+eoff] is op=0xa & minor=7 & es=3 & RdataExt & BaseExt & eoff { local ea=BaseExt+eoff*8; RdataExt=*[ram]:4 ea; }
:SETL [BaseExt+eoff],RdataExt is op=0xa & minor=5 & es=3 & RdataExt & BaseExt & eoff { local ea=BaseExt+eoff*8; *[ram]:4 ea = RdataExt; }
# ---- v0.5 batch: ADDT/MOVT, shifts, set-flags, SWAP ----
:MOVT Ddst,umm16 is op=0x0 & i25=1 & b0=1 & o1zb=1 & Ddst & umm16 { Ddst = umm16 << 16; }
:ADDT Ddst,Ds1,umm16 is op=0x0 & i25=1 & b0=1 & o1zb=0 & Ddst & Ds1 & umm16 { Ddst = Ds1 + (umm16 << 16); }
:MOVT Adst,umm16 is op=0x8 & i25=1 & b0=1 & o1zb=1 & Adst & umm16 { Adst = umm16 << 16; }
:ADDT Adst,As1,umm16 is op=0x8 & i25=1 & b0=1 & o1zb=0 & Adst & As1 & umm16 { Adst = As1 + (umm16 << 16); }
:LSL Ddst,Ds1,Ds2 is op=0x5 & i25=0 & st=0 & Ddst & Ds1 & Ds2 { Ddst = Ds1 << Ds2; }
:LSL Ddst,Ds1,shamt5 is op=0x5 & i25=1 & st=0 & Ddst & Ds1 & shamt5 { Ddst = Ds1 << shamt5; }
:LSR Ddst,Ds1,Ds2 is op=0x5 & i25=0 & st=1 & Ddst & Ds1 & Ds2 { Ddst = Ds1 >> Ds2; }
:LSR Ddst,Ds1,shamt5 is op=0x5 & i25=1 & st=1 & Ddst & Ds1 & shamt5 { Ddst = Ds1 >> shamt5; }
:ASL Ddst,Ds1,Ds2 is op=0x5 & i25=0 & st=2 & Ddst & Ds1 & Ds2 { Ddst = Ds1 << Ds2; }
:ASL Ddst,Ds1,shamt5 is op=0x5 & i25=1 & st=2 & Ddst & Ds1 & shamt5 { Ddst = Ds1 << shamt5; }
:ASR Ddst,Ds1,Ds2 is op=0x5 & i25=0 & st=3 & Ddst & Ds1 & Ds2 { Ddst = Ds1 s>> Ds2; }
:ASR Ddst,Ds1,shamt5 is op=0x5 & i25=1 & st=3 & Ddst & Ds1 & shamt5 { Ddst = Ds1 s>> shamt5; }
:ADDS Ddst,Ds1,Ds2 is op=0x0 & i25=0 & c26=0 & m27=1 & Ddst & Ds1 & Ds2 { CF=carry(Ds1,Ds2); Ddst=Ds1+Ds2; ZF=(Ddst==0); NF=(Ddst s< 0); }
:SUBS Ddst,Ds1,Ds2 is op=0x1 & i25=0 & c26=0 & m27=1 & Ddst & Ds1 & Ds2 { CF=(Ds1 < Ds2); Ddst=Ds1-Ds2; ZF=(Ddst==0); NF=(Ddst s< 0); }
:ANDS Ddst,Ds1,Ds2 is op=0x2 & i25=0 & c26=0 & m27=1 & Ddst & Ds1 & Ds2 { Ddst=Ds1&Ds2; ZF=(Ddst==0); NF=(Ddst s< 0); }
:ORS Ddst,Ds1,Ds2 is op=0x3 & i25=0 & c26=0 & m27=1 & Ddst & Ds1 & Ds2 { Ddst=Ds1|Ds2; ZF=(Ddst==0); NF=(Ddst s< 0); }
:SWAP Udst,Usrc is op=0xa & minor=3 & b9=1 & Udst & Usrc { local t=Udst; Udst=Usrc; Usrc=t; }
# ---- v0.6: condition subtable, cond-ALU, NEG, JUMP, NOP ----
CND: "EQ" is ccf=1 { local c:1 = ZF; export c; }
CND: "NE" is ccf=2 { local c:1 = ZF==0; export c; }
CND: "CS" is ccf=3 { local c:1 = CF; export c; }
CND: "CC" is ccf=4 { local c:1 = CF==0; export c; }
CND: "MI" is ccf=5 { local c:1 = NF; export c; }
CND: "PL" is ccf=6 { local c:1 = NF==0; export c; }
CND: "VS" is ccf=7 { local c:1 = VF; export c; }
CND: "VC" is ccf=8 { local c:1 = VF==0; export c; }
CND: "HI" is ccf=9 { local c:1 = CF&&ZF==0; export c; }
CND: "LS" is ccf=10 { local c:1 = CF==0||ZF; export c; }
CND: "GE" is ccf=11 { local c:1 = NF==VF; export c; }
CND: "LT" is ccf=12 { local c:1 = NF!=VF; export c; }
CND: "GT" is ccf=13 { local c:1 = ZF==0&&NF==VF; export c; }
CND: "LE" is ccf=14 { local c:1 = ZF||NF!=VF; export c; }
:ADD Ddst,Ds1,Ds2,CND is op=0x0 & i25=0 & c26=1 & Ddst & Ds1 & Ds2 & CND { if (CND==0) goto <done>; Ddst=Ds1+Ds2; <done> }
:SUB Ddst,Ds1,Ds2,CND is op=0x1 & i25=0 & c26=1 & Ddst & Ds1 & Ds2 & CND { if (CND==0) goto <done>; Ddst=Ds1-Ds2; <done> }
:ADD Adst,As1,As2,CND is op=0x8 & i25=0 & c26=1 & Adst & As1 & As2 & CND { if (CND==0) goto <done>; Adst=As1+As2; <done> }
:MOV Ddst,imm16,CND is op=0x0 & i25=1 & c26=1 & o1zb=1 & Ddst & imm16 & CND { if (CND==0) goto <done>; Ddst=imm16; <done> }
:NEG Ddst,Ds2 is op=0x1 & i25=0 & c26=0 & o1zb=1 & m27=0 & Ddst & Ds2 { Ddst = -Ds2; }
:NEG Ddst,imm16 is op=0x1 & i25=1 & c26=0 & o1zb=1 & b0=0 & Ddst & imm16 { Ddst = -imm16; }
JReg: jrno_a1 is jru=0 & jrno_a1 { export jrno_a1; }
JReg: jrno_d0 is jru=1 & jrno_d0 { export jrno_d0; }
JReg: jrno_d1 is jru=2 & jrno_d1 { export jrno_d1; }
JReg: jrno_a0 is jru=3 & jrno_a0 { export jrno_a0; }
:JUMP JReg,joff is op=0xa & minor=0xc & JReg & joff { local t=JReg+joff; goto [t]; }
:NOP is op=0xa & minor=0 & bcc=0xf { }
# ---- v0.7: MIN/MAX/ABS, imm logic, and-top, XORS, XSDW/XSDB, XFR, catch-all ----
:MIN Ddst,Ds1,Ds2 is op=0x7 & minor=0 & op7sub=0x8 & Ddst & Ds1 & Ds2 { Ddst=Ds1; if (Ds1 s< Ds2) goto <m>; Ddst=Ds2; <m> }
:MAX Ddst,Ds1,Ds2 is op=0x7 & minor=0 & op7sub=0x9 & Ddst & Ds1 & Ds2 { Ddst=Ds1; if (Ds1 s> Ds2) goto <m>; Ddst=Ds2; <m> }
:ABS Ddst,Ds1 is op=0x7 & minor=0 & op7sub=0xa & Ddst & Ds1 { Ddst=Ds1; if (Ds1 s>= 0) goto <m>; Ddst=0-Ds1; <m> }
:AND Ddst,Ds1,imm16 is op=0x2 & i25=1 & c26=0 & b0=0 & o1zb=0 & Ddst & Ds1 & imm16 { Ddst = Ds1 & imm16; }
:OR Ddst,Ds1,imm16 is op=0x3 & i25=1 & c26=0 & b0=0 & o1zb=0 & Ddst & Ds1 & imm16 { Ddst = Ds1 | imm16; }
:XOR Ddst,Ds1,imm16 is op=0x4 & i25=1 & c26=0 & b0=0 & o1zb=0 & Ddst & Ds1 & imm16 { Ddst = Ds1 ^ imm16; }
:ANDT Ddst,Ds1,umm16 is op=0x2 & i25=1 & b0=1 & o1zb=0 & Ddst & Ds1 & umm16 { Ddst = Ds1 & (umm16 << 16); }
:ORT Ddst,Ds1,umm16 is op=0x3 & i25=1 & b0=1 & o1zb=0 & Ddst & Ds1 & umm16 { Ddst = Ds1 | (umm16 << 16); }
:XORT Ddst,Ds1,umm16 is op=0x4 & i25=1 & b0=1 & o1zb=0 & Ddst & Ds1 & umm16 { Ddst = Ds1 ^ (umm16 << 16); }
:XORS Ddst,Ds1,Ds2 is op=0x4 & i25=0 & c26=0 & m27=1 & Ddst & Ds1 & Ds2 { Ddst=Ds1^Ds2; ZF=(Ddst==0); NF=(Ddst s< 0); }
:XSDB Ddst,Ds1 is op=0xa & minor=0xa & b1=0 & Ddst & Ds1 { Ddst = sext(Ds1:1); }
:XSDW Ddst,Ds1 is op=0xa & minor=0xa & b1=1 & Ddst & Ds1 { Ddst = sext(Ds1:2); }
# ---- generic per-major fallbacks (lowest priority; specifics win) ----
:op0 is op=0x0 { }
:op1 is op=0x1 { }
:op2 is op=0x2 { }
:op3 is op=0x3 { }
:op4 is op=0x4 { }
:op5 is op=0x5 { }
:mul_g is op=0x6 { }
:op7 is op=0x7 { }
:addr_g is op=0x8 { }
:op9 is op=0x9 { }
:misc_g is op=0xa { }
:set_g is op=0xb { }
:get_g is op=0xc { }
:xfr is op=0xd { }
:cpr is op=0xe { }
:fpu is op=0xf { }

# ================= conditional / 8-bit-immediate ALU (completion) =============
# cross-unit destination select when ca(bit5)=1: unit from dnu=(1,4) 1=D0 2=D1 3=A0 4=A1
DdstX: dno    is dnu=1 & dno    { export dno; }
DdstX: dno_d1 is dnu=2 & dno_d1 { export dno_d1; }
DdstX: dno_a0 is dnu=3 & dno_a0 { export dno_a0; }
DdstX: dno_a1 is dnu=4 & dno_a1 { export dno_a1; }

# condition boolean (ccf=(1,4)); 0=always and 15=never handled outside
ALUcc: "eq" is ccf=1  { local t = ZF!=0;              export t; }
ALUcc: "ne" is ccf=2  { local t = ZF==0;              export t; }
ALUcc: "cs" is ccf=3  { local t = CF!=0;              export t; }
ALUcc: "cc" is ccf=4  { local t = CF==0;              export t; }
ALUcc: "mi" is ccf=5  { local t = NF!=0;              export t; }
ALUcc: "pl" is ccf=6  { local t = NF==0;              export t; }
ALUcc: "vs" is ccf=7  { local t = VF!=0;              export t; }
ALUcc: "vc" is ccf=8  { local t = VF==0;              export t; }
ALUcc: "hi" is ccf=9  { local t = (CF!=0)&&(ZF==0);   export t; }
ALUcc: "ls" is ccf=10 { local t = (CF==0)||(ZF!=0);   export t; }
ALUcc: "ge" is ccf=11 { local t = NF==VF;             export t; }
ALUcc: "lt" is ccf=12 { local t = NF!=VF;             export t; }
ALUcc: "gt" is ccf=13 { local t = (ZF==0)&&(NF==VF);  export t; }
ALUcc: "le" is ccf=14 { local t = (ZF!=0)||(NF!=VF);  export t; }

# --- ADD/SUB/AND/OR/XOR  with 8-bit immediate (op=0..4, i25=1, c26=1) ---
# ca=1: cross-unit, unconditional
:ADD DdstX,Ds1,imm8 is op=0x0 & i25=1 & c26=1 & ca5=1 & DdstX & Ds1 & imm8 { DdstX = Ds1 + imm8; }
:SUB DdstX,Ds1,imm8 is op=0x1 & i25=1 & c26=1 & ca5=1 & DdstX & Ds1 & imm8 { DdstX = Ds1 - imm8; }
:AND DdstX,Ds1,imm8 is op=0x2 & i25=1 & c26=1 & ca5=1 & DdstX & Ds1 & imm8 { DdstX = Ds1 & imm8; }
:OR  DdstX,Ds1,imm8 is op=0x3 & i25=1 & c26=1 & ca5=1 & DdstX & Ds1 & imm8 { DdstX = Ds1 | imm8; }
:XOR DdstX,Ds1,imm8 is op=0x4 & i25=1 & c26=1 & ca5=1 & DdstX & Ds1 & imm8 { DdstX = Ds1 ^ imm8; }
# ca=0, cc=A: same-unit, unconditional
:ADD Ddst,Ds1,imm8 is op=0x0 & i25=1 & c26=1 & ca5=0 & ccf=0 & Ddst & Ds1 & imm8 { Ddst = Ds1 + imm8; }
:SUB Ddst,Ds1,imm8 is op=0x1 & i25=1 & c26=1 & ca5=0 & ccf=0 & Ddst & Ds1 & imm8 { Ddst = Ds1 - imm8; }
:AND Ddst,Ds1,imm8 is op=0x2 & i25=1 & c26=1 & ca5=0 & ccf=0 & Ddst & Ds1 & imm8 { Ddst = Ds1 & imm8; }
:OR  Ddst,Ds1,imm8 is op=0x3 & i25=1 & c26=1 & ca5=0 & ccf=0 & Ddst & Ds1 & imm8 { Ddst = Ds1 | imm8; }
:XOR Ddst,Ds1,imm8 is op=0x4 & i25=1 & c26=1 & ca5=0 & ccf=0 & Ddst & Ds1 & imm8 { Ddst = Ds1 ^ imm8; }
# ca=0, cc!=A: same-unit, conditional (predicated)
:ADD Ddst,Ds1,imm8,ALUcc is op=0x0 & i25=1 & c26=1 & ca5=0 & Ddst & Ds1 & imm8 & ALUcc { if (ALUcc==0) goto <sk>; Ddst = Ds1 + imm8; <sk> }
:SUB Ddst,Ds1,imm8,ALUcc is op=0x1 & i25=1 & c26=1 & ca5=0 & Ddst & Ds1 & imm8 & ALUcc { if (ALUcc==0) goto <sk>; Ddst = Ds1 - imm8; <sk> }
:AND Ddst,Ds1,imm8,ALUcc is op=0x2 & i25=1 & c26=1 & ca5=0 & Ddst & Ds1 & imm8 & ALUcc { if (ALUcc==0) goto <sk>; Ddst = Ds1 & imm8; <sk> }
:OR  Ddst,Ds1,imm8,ALUcc is op=0x3 & i25=1 & c26=1 & ca5=0 & Ddst & Ds1 & imm8 & ALUcc { if (ALUcc==0) goto <sk>; Ddst = Ds1 | imm8; <sk> }
:XOR Ddst,Ds1,imm8,ALUcc is op=0x4 & i25=1 & c26=1 & ca5=0 & Ddst & Ds1 & imm8 & ALUcc { if (ALUcc==0) goto <sk>; Ddst = Ds1 ^ imm8; <sk> }

# --- conditional MOV PC,D1RtP  == conditional RET ---
:RET ALUcc is op=0xa & minor=3 & b0=0 & reth=0x10045 & ALUcc { if (ALUcc==0) goto <sk>; return [D1RtP]; <sk> }
:RET ALUcc is op=0xa & minor=3 & b0=0 & reth=0x10055 & ALUcc { if (ALUcc==0) goto <sk>; return [D1RtP]; <sk> }

# ---- MSETL/MGETL D-unit (su=1) register save/restore (pairs D0.k/D1.k) ----
# Generated from the real reg-list algorithm (binutils metag-dis.c):
#   reg_no=bits(19,23); list = reg_no, then reg_no+i for each set bit i-1 of rmask.
# MSETL op=0xb, MGETL op=0xc, minor=9, unit bits(3,4)=1.
:MGETL [Base++] is op=0xc & minor=9 & eru=1 & msbn=0 & rmask=0x03 & Base { local p=Base; D0Re0=*[ram]:4 (p+0); D1Re0=*[ram]:4 (p+4); D0Ar6=*[ram]:4 (p+8); D1Ar5=*[ram]:4 (p+12); D0Ar4=*[ram]:4 (p+16); D1Ar3=*[ram]:4 (p+20); Base=Base+24; }
:MGETL [Base++] is op=0xc & minor=9 & eru=1 & msbn=0 & rmask=0x13 & Base { local p=Base; D0Re0=*[ram]:4 (p+0); D1Re0=*[ram]:4 (p+4); D0Ar6=*[ram]:4 (p+8); D1Ar5=*[ram]:4 (p+12); D0Ar4=*[ram]:4 (p+16); D1Ar3=*[ram]:4 (p+20); D0_5=*[ram]:4 (p+24); D1_5=*[ram]:4 (p+28); Base=Base+32; }
:MGETL [Base++] is op=0xc & minor=9 & eru=1 & msbn=1 & rmask=0x03 & Base { local p=Base; D0Ar6=*[ram]:4 (p+0); D1Ar5=*[ram]:4 (p+4); D0Ar4=*[ram]:4 (p+8); D1Ar3=*[ram]:4 (p+12); D0Ar2=*[ram]:4 (p+16); D1Ar1=*[ram]:4 (p+20); Base=Base+24; }
:MGETL [Base++] is op=0xc & minor=9 & eru=1 & msbn=1 & rmask=0x3f & Base { local p=Base; D0Ar6=*[ram]:4 (p+0); D1Ar5=*[ram]:4 (p+4); D0Ar4=*[ram]:4 (p+8); D1Ar3=*[ram]:4 (p+12); D0Ar2=*[ram]:4 (p+16); D1Ar1=*[ram]:4 (p+20); D0FrT=*[ram]:4 (p+24); D1RtP=*[ram]:4 (p+28); D0_5=*[ram]:4 (p+32); D1_5=*[ram]:4 (p+36); D0_6=*[ram]:4 (p+40); D1_6=*[ram]:4 (p+44); D0_7=*[ram]:4 (p+48); D1_7=*[ram]:4 (p+52); Base=Base+56; }
:MGETL [Base++] is op=0xc & minor=9 & eru=1 & msbn=2 & rmask=0x01 & Base { local p=Base; D0Ar4=*[ram]:4 (p+0); D1Ar3=*[ram]:4 (p+4); D0Ar2=*[ram]:4 (p+8); D1Ar1=*[ram]:4 (p+12); Base=Base+16; }
:MGETL [Base++] is op=0xc & minor=9 & eru=1 & msbn=2 & rmask=0x03 & Base { local p=Base; D0Ar4=*[ram]:4 (p+0); D1Ar3=*[ram]:4 (p+4); D0Ar2=*[ram]:4 (p+8); D1Ar1=*[ram]:4 (p+12); D0FrT=*[ram]:4 (p+16); D1RtP=*[ram]:4 (p+20); Base=Base+24; }
:MGETL [Base++] is op=0xc & minor=9 & eru=1 & msbn=2 & rmask=0x07 & Base { local p=Base; D0Ar4=*[ram]:4 (p+0); D1Ar3=*[ram]:4 (p+4); D0Ar2=*[ram]:4 (p+8); D1Ar1=*[ram]:4 (p+12); D0FrT=*[ram]:4 (p+16); D1RtP=*[ram]:4 (p+20); D0_5=*[ram]:4 (p+24); D1_5=*[ram]:4 (p+28); Base=Base+32; }
:MGETL [Base++] is op=0xc & minor=9 & eru=1 & msbn=4 & rmask=0x01 & Base { local p=Base; D0FrT=*[ram]:4 (p+0); D1RtP=*[ram]:4 (p+4); D0_5=*[ram]:4 (p+8); D1_5=*[ram]:4 (p+12); Base=Base+16; }
:MGETL [Base++] is op=0xc & minor=9 & eru=1 & msbn=4 & rmask=0x03 & Base { local p=Base; D0FrT=*[ram]:4 (p+0); D1RtP=*[ram]:4 (p+4); D0_5=*[ram]:4 (p+8); D1_5=*[ram]:4 (p+12); D0_6=*[ram]:4 (p+16); D1_6=*[ram]:4 (p+20); Base=Base+24; }
:MGETL [Base++] is op=0xc & minor=9 & eru=1 & msbn=4 & rmask=0x07 & Base { local p=Base; D0FrT=*[ram]:4 (p+0); D1RtP=*[ram]:4 (p+4); D0_5=*[ram]:4 (p+8); D1_5=*[ram]:4 (p+12); D0_6=*[ram]:4 (p+16); D1_6=*[ram]:4 (p+20); D0_7=*[ram]:4 (p+24); D1_7=*[ram]:4 (p+28); Base=Base+32; }
:MGETL [Base++] is op=0xc & minor=9 & eru=1 & msbn=5 & rmask=0x01 & Base { local p=Base; D0_5=*[ram]:4 (p+0); D1_5=*[ram]:4 (p+4); D0_6=*[ram]:4 (p+8); D1_6=*[ram]:4 (p+12); Base=Base+16; }
:MGETL [Base++] is op=0xc & minor=9 & eru=1 & msbn=5 & rmask=0x03 & Base { local p=Base; D0_5=*[ram]:4 (p+0); D1_5=*[ram]:4 (p+4); D0_6=*[ram]:4 (p+8); D1_6=*[ram]:4 (p+12); D0_7=*[ram]:4 (p+16); D1_7=*[ram]:4 (p+20); Base=Base+24; }
